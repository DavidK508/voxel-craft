{
  "name": "voxelcraft",
  "version": "1.3.0",
  "description": "VoxelCraft — a full-featured Minecraft-like voxel sandbox built with Electron and Three.js",
  "main": "main.js",
  "author": {
    "name": "VoxelCraft",
    "email": "voxelcraft@example.com"
  },
  "homepage": "https://example.com/voxelcraft",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "test": "node tests/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.voxelcraft.game",
    "productName": "VoxelCraft",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "assets/models/**/*",
      "node_modules/three/build/three.module.js",
      "node_modules/three/examples/jsm/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "rpm",
        "pacman",
        "apk",
        "freebsd",
        "tar.gz",
        "tar.xz",
        "zip",
        "7z"
      ],
      "category": "Game",
      "maintainer": "VoxelCraft <voxelcraft@example.com>",
      "synopsis": "VoxelCraft — воксельная песочница",
      "description": "VoxelCraft — полноценный клон Minecraft на Electron и Three.js: бесконечный мир, крафт, броня, кровати, жидкости и LAN-игра."
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    }
  }
}
